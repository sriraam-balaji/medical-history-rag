# Frontend (Vite) — from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend-only secrets: set these as Supabase Edge Function secrets
# (supabase secrets set ...), never in VITE_ variables, never committed.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_WEBHOOK_SECRET=
